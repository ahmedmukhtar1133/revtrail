{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "revtrail",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only API calls and /rt/ (the script and endpoint served from your own site) run the Worker; the
    // dashboard and /js/script.js are served as free static files.
    "run_worker_first": ["/api/*", "/rt/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "revtrail",
      // Replace with the id printed by `npx wrangler d1 create revtrail`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
